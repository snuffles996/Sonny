KV_REST_API_TOKEN=

# iCloud CalDAV
CALDAV_URL=https://caldav.icloud.com
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Calendars to read (comma-separated display names, case-insensitive)
CALDAV_READ_CALENDARS=Kevin's Calendar,Runna
# Calendar to write new events to
CALDAV_WRITE_CALENDAR=Kevin's Calendar
# Direct ICS subscription feeds (not native CalDAV — e.g. Runna, subscribed cals)
# Format: Name=https://url.ics,AnotherName=https://other.ics
ICS_SUBSCRIPTIONS=Runna=https://cal.runna.com/6bba4d38229be44aac48fdf4e57cc932.ics

# Auth — simple shared secret per user (expand later)
